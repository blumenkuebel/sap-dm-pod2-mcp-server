# SAP-proprietary specs — NOT redistributed. Fetch/generate locally via `npm run prepare:specs`.
# Governed by the applicable SAP terms of use / license, not by this repo's MIT license.
# NOTE: docu/pod2-api-specs/ is NOT ignored — the POD2 JSDoc bundle is public Apache-2.0
# (SAP-samples/digital-manufacturing-extension-samples) and ships with its own LICENSE/NOTICE.
docu/sap-dm-api-specs/
docu/sap-dm-mdo-specs/
# generated from SAP MDO $metadata by scripts/generate-mdo-index.cjs (SAP-derived)
