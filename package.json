{
  "name": "sap-dm-pod2-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for SAP Digital Manufacturing POD2 plugin development — patterns, API reference, REST specs, UI5 docs",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.js",
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js --stdio",
    "dev": "tsc --watch",
    "extract-docs": "node scripts/extract-jsdoc.cjs",
    "generate-mdo-index": "node scripts/generate-mdo-index.cjs",
    "fetch-rest-specs": "node scripts/fetch-rest-specs.mjs",
    "update-ui5-api-specs": "node scripts/update-ui5-api-specs.mjs",
    "check-ui5-api-freshness": "node scripts/check-ui5-api-freshness.mjs",
    "prepare:specs": "node scripts/extract-jsdoc.cjs && node scripts/generate-mdo-index.cjs && node scripts/update-ui5-api-specs.mjs"
  },
  "dependencies": {
    "fastmcp": "^4.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "mcp",
    "sap",
    "digital-manufacturing",
    "pod2",
    "fastmcp"
  ],
  "license": "MIT"
}
